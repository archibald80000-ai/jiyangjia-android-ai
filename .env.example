# Never put real values in this file.
APP_ENV=
LOG_LEVEL=

# Display strategy
DISPLAY_MODE=
LIVETALKING_BASE_URL=
LIVETALKING_WHEP_URL=
LIVETALKING_AVATAR_ID=
LIVETALKING_MODEL=
LIVETALKING_REQUEST_TIMEOUT_SECONDS=

# Gateway
GATEWAY_HOST=
GATEWAY_PORT=
PUBLIC_BASE_URL=
DATABASE_URL=
CLIENT_TOKEN_CHANGE_ME=

# Provider selection
JIYANGJIA_ASR_PROVIDER=
JIYANGJIA_TTS_PROVIDER=
JIYANGJIA_LLM_PROVIDER=
JIYANGJIA_EMBEDDING_PROVIDER=
KNOWLEDGE_PROVIDER=
JIYANGJIA_KNOWLEDGE_DB_PATH=
JIYANGJIA_KNOWLEDGE_FAISS_PATH=

# TASK-014A local admin/content state. ADMIN_TOKEN is required in production.
JIYANGJIA_ADMIN_DB_PATH=
JIYANGJIA_ADMIN_UPLOAD_DIR=
JIYANGJIA_ASSET_DIR=
JIYANGJIA_MAX_KNOWLEDGE_UPLOAD_BYTES=
JIYANGJIA_MAX_ASSET_UPLOAD_BYTES=
ADMIN_TOKEN=

# Public knowledge/material entry gate. Store only a PBKDF2 hash and a random
# session signing secret. Generate them with scripts/hash_public_gate_password.py.
JIYANGJIA_PUBLIC_GATE_PASSWORD_HASH=
JIYANGJIA_PUBLIC_GATE_SESSION_SECRET=
JIYANGJIA_PUBLIC_GATE_SESSION_TTL_SECONDS=86400

# Doubao / Volcengine placeholders
# TTS: set JIYANGJIA_TTS_PROVIDER=doubao only after these are configured.
# Preferred Phase 1 realtime-style synthesis uses the official V3 unidirectional
# endpoint. Configure either DOUBAO_TTS_API_KEY or APP_ID + ACCESS_TOKEN.
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_SPEAKER=
DOUBAO_TTS_RESOURCE_ID=
DOUBAO_TTS_ENDPOINT=
DOUBAO_TTS_SAMPLE_RATE=
DOUBAO_TTS_SPEECH_RATE=
DOUBAO_TTS_CLUSTER=
DOUBAO_TTS_ENCODING=
# Legacy v1 compatibility only:
DOUBAO_TTS_VOICE_TYPE=

# ASR: set JIYANGJIA_ASR_PROVIDER=doubao only after auth is configured.
# Preferred Phase 1 path uses server-side file/bytes -> WebSocket chunks,
# not always-on Android streaming.
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=
DOUBAO_ASR_ENDPOINT=
DOUBAO_STREAMING_ASR_ENDPOINT=
DOUBAO_ASR_AUDIO_FORMAT=
DOUBAO_ASR_CHUNK_BYTES=
DOUBAO_ASR_TIMEOUT_SECONDS=
# Optional official self-learning hotword table. Configure one, preferably ID.
DOUBAO_ASR_BOOSTING_TABLE_ID=
DOUBAO_ASR_BOOSTING_TABLE_NAME=
# Optional JSON string for official direct context/correct_words parameters.
DOUBAO_ASR_CONTEXT_JSON=

# LLM / Embedding: TASK-011 provider adapters.
JIYANGJIA_LLM_TIMEOUT_SECONDS=
JIYANGJIA_LLM_MAX_TOKENS=
JIYANGJIA_LLM_TEMPERATURE=
JIYANGJIA_EMBEDDING_TIMEOUT_SECONDS=

# DeepSeek OpenAI-compatible chat. Set JIYANGJIA_LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
DEEPSEEK_MODEL=

# Doubao / Volcengine Ark OpenAI-compatible chat and embeddings.
# Set JIYANGJIA_LLM_PROVIDER=doubao or JIYANGJIA_EMBEDDING_PROVIDER=doubao.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=
DOUBAO_MODEL=
DOUBAO_EMBEDDING_API_KEY=
DOUBAO_EMBEDDING_BASE_URL=
DOUBAO_EMBEDDING_MODEL=
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Other optional providers
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=

# Privacy and retention
SAVE_RAW_AUDIO=
RAW_AUDIO_RETENTION_HOURS=
SAVE_TRANSCRIPTS=
TRANSCRIPT_RETENTION_DAYS=
MASK_PII_IN_LOGS=

# Controlled Android release metadata. URL must be trusted HTTPS.
JIYANGJIA_ANDROID_RELEASE_PACKAGE=ai.jiyangjia.kiosk
JIYANGJIA_ANDROID_RELEASE_VERSION_CODE=
JIYANGJIA_ANDROID_RELEASE_VERSION_NAME=
JIYANGJIA_ANDROID_RELEASE_APK_URL=
JIYANGJIA_ANDROID_RELEASE_SIZE_BYTES=
JIYANGJIA_ANDROID_RELEASE_SHA256=
JIYANGJIA_ANDROID_RELEASE_CERTIFICATE_SHA256=
JIYANGJIA_ANDROID_RELEASE_NOTES=
