# Never put real values in this file.
APP_ENV=development
LOG_LEVEL=INFO

# Display strategy
DISPLAY_MODE=idle_video_voice
LIVETALKING_BASE_URL=http://127.0.0.1:8010
LIVETALKING_WHEP_URL=http://127.0.0.1:8010/whep
LIVETALKING_AVATAR_ID=wav2lip256_avatar1
LIVETALKING_MODEL=wav2lip
LIVETALKING_REQUEST_TIMEOUT_SECONDS=15

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
DATABASE_URL=sqlite:///./runtime/jiyangjia.db
CLIENT_TOKEN_CHANGE_ME=replace-me

# Provider selection
JIYANGJIA_ASR_PROVIDER=mock
JIYANGJIA_TTS_PROVIDER=mock
JIYANGJIA_LLM_PROVIDER=mock
JIYANGJIA_EMBEDDING_PROVIDER=mock
KNOWLEDGE_PROVIDER=sqlite_faiss_lightweight_rag

# Doubao / Volcengine placeholders
# TTS: set JIYANGJIA_TTS_PROVIDER=doubao only after these are configured.
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_VOICE_TYPE=
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_ENCODING=mp3
DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v1/tts

# ASR: reserved for TASK-010.
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=
DOUBAO_ASR_RESOURCE_ID=

# LLM / Embedding: reserved for TASK-011.
ARK_API_KEY=
ARK_BASE_URL=
ARK_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=

# Other optional providers
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=

# Privacy and retention
SAVE_RAW_AUDIO=false
RAW_AUDIO_RETENTION_HOURS=0
SAVE_TRANSCRIPTS=true
TRANSCRIPT_RETENTION_DAYS=30
MASK_PII_IN_LOGS=true
