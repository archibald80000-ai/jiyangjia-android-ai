# Never put real values in this file.
APP_ENV=development
LOG_LEVEL=INFO

# Display strategy
DISPLAY_MODE=idle_video_voice
LIVETALKING_BASE_URL=http://127.0.0.1:8010
LIVETALKING_WHEP_URL=http://127.0.0.1:8010/whep
LIVETALKING_AVATAR_ID=wav2lip256_avatar1
LIVETALKING_MODEL=wav2lip
LIVETALKING_REQUEST_TIMEOUT_SECONDS=15

# Gateway
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8080
PUBLIC_BASE_URL=http://127.0.0.1:8080
DATABASE_URL=sqlite:///./runtime/jiyangjia.db
CLIENT_TOKEN_CHANGE_ME=replace-me

# Provider selection
JIYANGJIA_ASR_PROVIDER=mock
JIYANGJIA_TTS_PROVIDER=mock
JIYANGJIA_LLM_PROVIDER=mock
JIYANGJIA_EMBEDDING_PROVIDER=mock
KNOWLEDGE_PROVIDER=sqlite_faiss_lightweight_rag
JIYANGJIA_KNOWLEDGE_DB_PATH=:memory:
JIYANGJIA_KNOWLEDGE_FAISS_PATH=var/knowledge/faiss.index

# TASK-014A local admin/content state. ADMIN_TOKEN is required in production.
JIYANGJIA_ADMIN_DB_PATH=var/admin/admin.db
JIYANGJIA_ADMIN_UPLOAD_DIR=var/knowledge/uploads
JIYANGJIA_ASSET_DIR=var/assets
JIYANGJIA_MAX_KNOWLEDGE_UPLOAD_BYTES=20971520
JIYANGJIA_MAX_ASSET_UPLOAD_BYTES=262144000
ADMIN_TOKEN=

# Doubao / Volcengine placeholders
# TTS: set JIYANGJIA_TTS_PROVIDER=doubao only after these are configured.
# Preferred Phase 1 realtime-style synthesis uses the official V3 unidirectional
# endpoint. Configure either DOUBAO_TTS_API_KEY or APP_ID + ACCESS_TOKEN.
DOUBAO_TTS_APP_ID=
DOUBAO_TTS_ACCESS_TOKEN=
DOUBAO_TTS_API_KEY=
DOUBAO_TTS_SPEAKER=
DOUBAO_TTS_RESOURCE_ID=seed-tts-2.0
DOUBAO_TTS_ENDPOINT=https://openspeech.bytedance.com/api/v3/tts/unidirectional
DOUBAO_TTS_SAMPLE_RATE=24000
DOUBAO_TTS_SPEECH_RATE=-5
DOUBAO_TTS_CLUSTER=volcano_tts
DOUBAO_TTS_ENCODING=mp3
# Legacy v1 compatibility only:
DOUBAO_TTS_VOICE_TYPE=

# ASR: set JIYANGJIA_ASR_PROVIDER=doubao only after auth is configured.
# Preferred Phase 1 path uses server-side file/bytes -> WebSocket chunks,
# not always-on Android streaming.
DOUBAO_ASR_APP_ID=
DOUBAO_ASR_ACCESS_TOKEN=
DOUBAO_ASR_API_KEY=
DOUBAO_ASR_RESOURCE_ID=volc.bigasr.sauc.duration
DOUBAO_ASR_ENDPOINT=wss://openspeech.bytedance.com/api/v3/sauc/bigmodel_nostream
DOUBAO_ASR_AUDIO_FORMAT=wav
DOUBAO_ASR_CHUNK_BYTES=32000
DOUBAO_ASR_TIMEOUT_SECONDS=30

# LLM / Embedding: TASK-011 provider adapters.
JIYANGJIA_LLM_TIMEOUT_SECONDS=30
JIYANGJIA_LLM_MAX_TOKENS=320
JIYANGJIA_LLM_TEMPERATURE=0.2
JIYANGJIA_EMBEDDING_TIMEOUT_SECONDS=30

# DeepSeek OpenAI-compatible chat. Set JIYANGJIA_LLM_PROVIDER=deepseek.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Doubao / Volcengine Ark OpenAI-compatible chat and embeddings.
# Set JIYANGJIA_LLM_PROVIDER=doubao or JIYANGJIA_EMBEDDING_PROVIDER=doubao.
DOUBAO_API_KEY=
DOUBAO_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_MODEL=
DOUBAO_EMBEDDING_API_KEY=
DOUBAO_EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_EMBEDDING_MODEL=doubao-embedding-vision-251215
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_MODEL=
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
EMBEDDING_MODEL=doubao-embedding-vision-251215

# Other optional providers
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=
OPENAI_COMPATIBLE_API_KEY=
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_MODEL=
OPENAI_COMPATIBLE_EMBEDDING_API_KEY=
OPENAI_COMPATIBLE_EMBEDDING_BASE_URL=
OPENAI_COMPATIBLE_EMBEDDING_MODEL=

# Privacy and retention
SAVE_RAW_AUDIO=false
RAW_AUDIO_RETENTION_HOURS=0
SAVE_TRANSCRIPTS=true
TRANSCRIPT_RETENTION_DAYS=30
MASK_PII_IN_LOGS=true
